{
  "version": 2,
  "builds": [
    {
      "src": "magazine/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.12"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "magazine/wsgi.py"
    },
    {
      "src": "/media/(.*)",
      "dest": "magazine/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "magazine/wsgi.py"
    }
  ]
}
