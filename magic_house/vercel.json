{
  "version": 2,
  "builds": [
    {
      "src": "magic_house/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb", "runtime": "python3.12" }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "dest": "magic_house/wsgi.py" },
    { "src": "/(.*)", "dest": "magic_house/wsgi.py" }
  ]
}
